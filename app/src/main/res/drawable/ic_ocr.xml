<?xml version="1.0" encoding="utf-8"?>
<!--
  OCR: find the words in a document.

  This file used to hold a byte-for-byte copy of ic_scan.xml, so "Scan to PDF" and
  "Make searchable (OCR)" showed the same picture in the app. They are different jobs:
  one captures a page, the other reads the text already on it. The page here carries two
  lines of text and a magnifier sits over the corner of it, which says "find the words"
  without repeating the scan frame's corner brackets.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <!-- the page, with a folded corner -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M300,120 L600,120 L760,280 L760,470 L680,470 L680,320 L560,200 L300,200 L300,760 L470,760 L470,840 L300,840 Q260,840 260,800 L260,160 Q260,120 300,120 Z" />
    <!-- two lines of text on it -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M340,320 L620,320 L620,380 L340,380 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M340,460 L520,460 L520,520 L340,520 Z" />
    <!-- the magnifier: a ring and a handle -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M640,530 A110,110 0 1,1 640,750 A110,110 0 1,1 640,530 Z M640,590 A50,50 0 1,0 640,690 A50,50 0 1,0 640,590 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M720,730 L820,830 L760,890 L660,790 Z" />
</vector>
