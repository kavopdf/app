<?xml version="1.0" encoding="utf-8"?>
<!-- The "Open with" list.
     A plain view rather than the stock dialog's adapter, for one reason: the Cancel has to
     be an outlined pill like every other confirmation in this app. A bare text button
     sitting under a list of apps reads as another row of the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/openWithTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/open_with_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Rows are inflated into this, one per app, from row_app_choice.xml. -->
    <LinearLayout
        android:id="@+id/openWithList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openWithCancel"
        style="@style/Widget.KavoPDF.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:minWidth="120dp"
        android:text="@string/action_cancel" />
</LinearLayout>
