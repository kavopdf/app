<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the "Open with" list. A dialog row, not a card: the list sits inside a
     dialog, and the icon and the name are the only two things it needs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="33.6dp"
        android:layout_height="33.6dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/appName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="15.75sp"
        tools:text="App" />
</LinearLayout>
