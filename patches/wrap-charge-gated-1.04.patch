+    /**
+     * How many lines the renderer will draw for one cell's text at one type size.
+     *
+     * <p>Split on the cell's OWN paragraph breaks: a cell holding nine paragraphs is nine
+     * line boxes at least, whatever its width. Each paragraph is charged
+     * {@code ceil(textWidth / availTw)} and never less than one.
+     */
+    private static int wrapLinesForCell(String text, float sz, int availTw, boolean bold) {
+        if (text == null || text.isEmpty() || availTw <= 0 || sz <= 0f) return 1;
+        int total = 0;
+        int from = 0;
+        for (int i = 0; i <= text.length(); i++) {
+            if (i == text.length() || text.charAt(i) == '\n') {
+                String para = text.substring(from, i);
+                from = i + 1;
+                float wTw = (float) (helvAdvanceEm(para, bold) * sz * TWIPS_PER_PT);
+                // THE METRIC IS NOT THE FACE THE RENDERER USES. Helvetica's advances are within
+                // a few per cent of DejaVu Sans, and a cell the writer has already widened to
+                // hold its text sits within that few per cent of its own width. Charging a
+                // second line for a 1 twip excess doubled 38 of 38 rows of
+                // price-list-right-aligned-amounts (312 -> 624 tw) and spilled its page,
+                // 1.79 -> 81.15. Below 4 % over, the cell is one line whatever the sum says.
+                int n = wTw <= availTw * 1.04f ? 1 : (int) Math.ceil(wTw / (float) availTw);
