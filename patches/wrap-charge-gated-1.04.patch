+    /**
+     * The advance width of a string in Helvetica, in em units.
+     *
+     * <p>Standard-14 metrics: PDFBox ships the AFM files, so this is the face a renderer
+     * substitutes for an unknown font, measured rather than estimated. Bold takes the bold
+     * AFM. Any failure falls back to the 0.5 em average this replaced, which is what the rest
+     * of the writer still uses - a missing metric must not change a document that already fits.
+     */
+    private static float helvAdvanceEm(String s, boolean bold) {
+        if (s == null || s.isEmpty()) return 0f;
+        try {
+            com.tom_roush.pdfbox.pdmodel.font.PDFont f = bold
+                    ? com.tom_roush.pdfbox.pdmodel.font.PDType1Font.HELVETICA_BOLD
+                    : com.tom_roush.pdfbox.pdmodel.font.PDType1Font.HELVETICA;
+            return f.getStringWidth(s) / 1000f;
+        } catch (Throwable e) {
+            return s.length() * 0.5f;
+        }
+    }
