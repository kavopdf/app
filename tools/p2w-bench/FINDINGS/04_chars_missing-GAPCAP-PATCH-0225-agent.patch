+    private static boolean spendWideGap(Ctx ctx, float gapPt, float lineTopPt, float linePt) {
+        if (!SPEND_FOOT_GAP) return false;
+        // A line inside a column cell is not on the page's own flow at all.
+        if (ctx.inColumn) return false;
+        // 1. nothing the flow writes runs under this line.
+        if (lineTopPt < FOOT_BAND * ctx.pageHeightPt) return false;
+        int gapTw = (int) Math.max(0L, Math.round(gapPt * TWIPS_PER_PT));
+        int lineTw = (int) Math.max(1L, Math.round(linePt * TWIPS_PER_PT));
