+# How many non-empty lines at each edge of a page segment count as "in the band" for the .txt
+# side. The source side uses a 12 % geometric band; a .txt has no coordinates, so the same
+# population is recovered as the first and last few lines of each U+000C-delimited segment.
+# 3 is enough for a header, a footer and a page number, and small enough that a form's body
+# cannot leak in.
+FURNITURE_TXT_EDGE_LINES = 3
+
 # An element has to repeat on this many pages before it is furniture. Two pages is a
 # coincidence, and on a two-page document every repeated line would qualify.
 FURNITURE_MIN_PAGES = 3
@@ -1281,9 +1288,39 @@ def compare(src_pdf, txt_path):
     # data. A running head or footer carries at least one letter; a column of amounts
