+     *
+     * <p>A shape is placed by its own {@code topPt}, not by its position in {@code page.blocks}
+     * - attachShapes appends them all after the paragraphs, so list order is the opposite of
+     * the order the page drew them. Writing them in top order is what lets {@link #ruleAsBorder}
+     * see a rule while the flow is still above it: a paragraph border can only be moved FORWARD
+     * by {@code w:before}, so a rule written at the foot of the page can only land at the foot.
+     *
+     * <p>{@code upto} is the next block's top: a shape at or above it belongs before that block.
+     * The final call passes {@link Float#POSITIVE_INFINITY} for the shapes below all the text.
+     */
+    private static void flushShapes(StringBuilder sb, PdfToWord.Page page, Ctx ctx,
+                                    float upto, boolean[] written) {
+        while (true) {
+            int pick = -1;
+            float pickTop = Float.POSITIVE_INFINITY;
+            for (int i = 0; i < page.blocks.size(); i++) {
+                if (written[i]) continue;
+                Object b = page.blocks.get(i);
+                if (!(b instanceof Shape)) continue;
+                float t = ((Shape) b).topPt;
+                if (t <= upto && t < pickTop) { pick = i; pickTop = t; }
+            }
+            if (pick < 0) return;
+            written[pick] = true;
+            emitBlock(sb, page.blocks.get(pick), ctx);
+        }
+    }
