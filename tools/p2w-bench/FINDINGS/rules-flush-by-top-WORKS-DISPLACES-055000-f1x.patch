+    /**
+     * Writes a horizontal hairline as a paragraph border, when the flow can place it exactly.
+     *
+     * <p>Google Docs drops a floating {@code <w:drawing>} and keeps only its {@code U+200B}
+     * anchor; a {@code w:pBdr} bottom border is a construct it honours. That is worth 53
+     * documents on {@code 32_stroke_lines} and 48 on {@code 05_chars_extra}.
+     *
+     * <p>A border is placed BY FLOW, so it is only correct where the flow has a real position to
+     * measure the gap from and that position is at or above the rule. Returns false - leaving
+     * the drawing path untouched - whenever either is not true, because a border at the wrong y
+     * is a LibreOffice regression on every document with a rule, and LibreOffice draws the
+     * drawing correctly today.
+     *
+     * @return true when the border was written and the flow has been moved onto it
+     */
+    private static boolean ruleAsBorder(StringBuilder sb, Shape s, Ctx ctx) {
+        if (!isHairline(s)) return false;
+        if (Math.abs(s.hPt) > Math.abs(s.wPt)) return false;   // vertical rules are not pBdr bottom
+        int rgb = s.lineRgb >= 0 ? s.lineRgb : s.fillRgb;
+        if (rgb < 0) return false;
+        // The flow's position on this sheet: 0 at the top of a fresh page, otherwise where the
+        // reader will put the last baseline. A rule at or above it cannot be reached by w:before.
+        float from = (ctx.newPage || ctx.flowY < 0f) ? 0f : ctx.flowY;
+        if (!(s.topPt > from)) return false;
+        // The border is drawn at the BOTTOM of the carrier paragraph's box, so the gap is the
+        // distance to the rule less the carrier's own one-twip line. Subtracting the previous
+        // line's descent as well put both borders 2.35 pt high on
+        // 18_centred_heading_left_body_txtpos (measured: 107.65 and 791.54 against rules at
+        // 110.0 and 793.89) and that is what made 18_displacement fail there.
+        int beforeTw = (int) Math.max(0L,
+                Math.round((s.topPt - from) * TWIPS_PER_PT) - 1L);
+
+        int szEighth = (int) Math.max(2L, Math.round(s.lineWidthPt * 8f));
+        int leftTw = (int) Math.max(0L, Math.round(s.xPt * TWIPS_PER_PT));
+        int rightTw = (int) Math.max(0L,
+                Math.round((ctx.pageWidthPt - (s.xPt + s.wPt)) * TWIPS_PER_PT));
+
+        sb.append("<w:p><w:pPr><w:snapToGrid w:val=\"0\"/>")
+                .append("<w:pBdr><w:bottom w:val=\"single\" w:sz=\"").append(szEighth)
+                .append("\" w:space=\"0\" w:color=\"").append(hex(rgb)).append("\"/></w:pBdr>")
+                .append("<w:ind w:left=\"").append(leftTw).append("\" w:right=\"").append(rightTw)
+                .append("\" w:firstLine=\"0\"/>")
+                .append("<w:spacing w:beforeAutospacing=\"0\" w:afterAutospacing=\"0\"")
+                .append(" w:before=\"").append(beforeTw)
+                .append("\" w:after=\"0\" w:line=\"1\" w:lineRule=\"exact\"/>")
+                .append("<w:rPr><w:sz w:val=\"2\"/><w:szCs w:val=\"2\"/></w:rPr></w:pPr>")
+                .append("<w:r><w:rPr><w:sz w:val=\"2\"/><w:szCs w:val=\"2\"/></w:rPr>")
+                .append("<w:t xml:space=\"preserve\"> </w:t></w:r></w:p>");
+
+        // The border IS the flow's new position. Without this the next paragraph measures its
+        // gap from the line ABOVE the rule, and every line below the rule on the page moves up
+        // by the rule's gap - an 18_displacement regression on every document with a rule.
+        ctx.flowY = s.topPt;
+        ctx.flowBoxPt = 0f;
+        ctx.newPage = false;
+        return true;
+    }
