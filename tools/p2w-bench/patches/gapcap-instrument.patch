+    /**
+     * The cap as an experiment can see it: {@code -Dp2w.gapcap=<twips>} overrides the non-spend
+     * ceiling so one build can be dosed across the corpus without a recompile per value.
+     *
+     * <p>An instrument, not a change: with no property set it returns exactly what
+     * {@link #gapCapTw} returns, so the default build is byte-identical in behaviour. It exists
+     * because the 120 pt ceiling decides whether body text is written as a paragraph or as an
+     * anchored DrawingML box, which Google rasterises - and that question needs a dose-response
+     * over 213 documents, not an opinion.
+     */
+    private static int gapCapTwEff(Ctx ctx) {
+        if (ctx.spendGaps) return GAP_CAP_SPEND_TW;
+        String v = System.getProperty("p2w.gapcap");
+        if (v != null && !v.isEmpty()) {
+            try { return Integer.parseInt(v.trim()); } catch (NumberFormatException e) { /* keep default */ }
+        }
+        return GAP_CAP_TW;
+    }
