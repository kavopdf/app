 def _rule_segments(page, band=None):
+def _rule_segments_with_pictures(page, band=None):
+    """_rule_segments() plus the rules Google drew as pictures.
+
+    Google exports every anchored shape as one raster image, so a rule it drew
+    perfectly reads as zero segments from get_drawings(). _stroke_pictures()
+    already finds those bands but returns {rect,width,colour}; this maps them
+    into the {o,perp,a,b,t,col} shape _rule_segments() returns, using the same
+    band test it applies to a filled band.
+
+    MEASURED 21 Nov on ten Google exports: rule-base (no rule) and
+    rule-v6_pgborder (Google dropped it) stay LOST; rule-v1_drawing and
+    rule-v1b_inline go LOST -> MATCHED. See
+    FINDINGS/32_stroke_lines-CHECK-BLIND-TO-PICTURES-2340-f1x.md.
+    DO NOT make check 32 use this until a corpus pass measures the new column.
+    """
+    band = RULE_BAND if band is None else band
+    out = _rule_segments(page, band)
+    for pic in _stroke_pictures(page):
+        r = pic["rect"]
+        h, w = r.height, r.width
+        if h <= band and w > h:
+            out.append({"o": "h", "perp": (r.y0 + r.y1) / 2.0, "a": r.x0, "b": r.x1,
+                        "t": max(0.05, h), "col": pic.get("colour")})
+        elif w <= band and h > w:
+            out.append({"o": "v", "perp": (r.x0 + r.x1) / 2.0, "a": r.y0, "b": r.y1,
+                        "t": max(0.05, w), "col": pic.get("colour")})
+    return out
