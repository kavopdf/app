+def _cell_probe(doc):
+    """(page, x0, x1, y0, y1) -> is this box inside a closed table cell?
+
+    Geometric, so it does not depend on the .docx surviving the round trip. A box is in a
+    cell when a vertical rule stands to its left and another to its right, both spanning
+    its band, no wider than a cell apart, with a horizontal rule above and below joining
+    them. Validated against an independent whole-line/docx-cell-text match: 95.6 %
+    agreement on 18078 judged runs (AUDIT-47-POPULATION.md).
+    """
+    per = []
+    for page in doc:
+        V, H = [], []
+        for d in page.get_drawings():
+            for it in d["items"]:
+                if it[0] == "l":
+                    a, b = it[1], it[2]
+                    if abs(a.x - b.x) < 0.6 and abs(a.y - b.y) > 3:
+                        V.append((a.x, min(a.y, b.y), max(a.y, b.y)))
+                    if abs(a.y - b.y) < 0.6 and abs(a.x - b.x) > 3:
+                        H.append((a.y, min(a.x, b.x), max(a.x, b.x)))
+                elif it[0] == "re":
+                    r = it[1]
+                    if r.height > 3:
+                        V.append((r.x0, r.y0, r.y1)); V.append((r.x1, r.y0, r.y1))
+                    if r.width > 3:
+                        H.append((r.y0, r.x0, r.x1)); H.append((r.y1, r.x0, r.x1))
+        V = sorted(set((round(x, 1), round(a, 1), round(b, 1)) for x, a, b in V))
+        H = sorted(set((round(y, 1), round(a, 1), round(b, 1)) for y, a, b in H))
+
+        def _inside(x0, x1, y0, y1, _V=V, _H=H):
+            if len(_V) < 2 or len(_H) < 2:
+                return False
+            ym = (y0 + y1) / 2.0
+            L = [x for x, a, b in _V if x <= x0 + 0.6 and a - 0.6 <= ym <= b + 0.6]
+            R = [x for x, a, b in _V if x >= x1 - 0.6 and a - 0.6 <= ym <= b + 0.6]
+            if not L or not R:
+                return False
+            xl, xr = max(L), min(R)
+            if xr - xl > 420 or xr <= xl:
+                return False
+            up = [y for y, a, b in _H if y <= y0 + 2 and a - 1 <= xl <= b + 1
+                  and a - 1 <= xr <= b + 1]
+            dn = [y for y, a, b in _H if y >= y1 - 2 and a - 1 <= xl <= b + 1
+                  and a - 1 <= xr <= b + 1]
+            return bool(up) and bool(dn)
+
+        per.append(_inside)
+    return lambda pi, x0, x1, y0, y1: per[pi](x0, x1, y0, y1) if pi < len(per) else False
+
