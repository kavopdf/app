+    /**
+     * The page's gutters, projected band by band instead of all at once.
+     *
+     * <p>{@link #keep0} projects every glyph of the page together, so one element that reaches
+     * across a gutter removes it from the whole page - a pull quote, a spanning heading, or a
+     * KPI panel whose cell is 17 pt wider than the column above it. Each of the six bands is
+     * projected on its own and a gutter that at least half of them report is returned with its
+     * vote count. A gutter the whole page already has is reported by every band and comes back
+     * here too; the caller drops it as already present.
+     */
+    private static List<float[]> bandGutters(List<Line> rawLines, float fullWidth) {
+        List<float[]> out = new ArrayList<>();
+        float top = Float.MAX_VALUE, bot = -Float.MAX_VALUE;
+        for (Line l : rawLines) {
+            if (l.text.trim().isEmpty()) continue;
+            top = Math.min(top, l.y);
+            bot = Math.max(bot, l.y);
+        }
+        final int bandsN = 6;
+        float bh = (bot - top) / bandsN;
+        if (bh <= 8f) return out;
+        List<float[]> votes = new ArrayList<>();
+        for (int b = 0; b < bandsN; b++) {
+            float y0 = top + b * bh, y1 = y0 + bh;
+            List<Line> sub = new ArrayList<>();
+            for (Line l : rawLines) if (l.y >= y0 && l.y < y1) sub.add(l);
+            if (sub.size() < 4) continue;
+            for (Float g : keep0(sub, fullWidth)) votes.add(new float[]{g, b});
+        }
+        Collections.sort(votes, new Comparator<float[]>() {
+            @Override
+            public int compare(float[] a, float[] b) { return Float.compare(a[0], b[0]); }
+        });
+        int need = Math.max(2, (bandsN + 1) / 2);
+        int i = 0;
+        while (i < votes.size()) {
+            int j = i;
+            float sum = 0f;
+            java.util.LinkedHashSet<Integer> seen = new java.util.LinkedHashSet<>();
+            while (j < votes.size() && votes.get(j)[0] - votes.get(i)[0] <= 6f) {
+                sum += votes.get(j)[0];
+                seen.add((int) votes.get(j)[1]);
+                j++;
+            }
+            if (seen.size() >= need) out.add(new float[]{sum / (j - i), seen.size()});
+            i = j;
+        }
+        return out;
+    }
