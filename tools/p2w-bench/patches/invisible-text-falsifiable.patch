+def _page_array(page, dpi=BG_DPI):
+    """The page as an (h, w, 3) float array in 0..1, or None when numpy is unavailable."""
+    try:
+        import numpy as np
+    except ImportError:
+        return None
+    pm = page.get_pixmap(dpi=dpi, colorspace=fitz.csRGB, alpha=False)
+    return np.frombuffer(pm.samples, dtype=np.uint8).reshape(
+        pm.h, pm.w, pm.n)[:, :, :3].astype(np.float32) / 255.0
+
+
+def _pixel_background(arr, page, r, dpi=BG_DPI):
+    """The colour behind one run, and how uniform it is: (rgb, purity) or (None, purity).
+
+    The sample is a ring just outside the run's ink box - never inside it, where the
+    glyph's own antialiased edges would be counted as background. The ring grows only
+    until it has BG_MIN_PX pixels, and never past BG_RING_MAX. A background that is not
+    at least BG_PURITY one colour returns None: there is no single colour behind that run
+    to be invisible against, so the run abstains rather than being guessed at.
+    """
+    import numpy as np
+    s = dpi / 72.0
+    W, H = page.rect.width, page.rect.height
+    ax = max(0, min(int(np.floor(r["x"] * s)), int(W * s) - 1))
+    ay = max(0, min(int(np.floor(r["y"] * s)), int(H * s) - 1))
+    bx = max(ax + 1, min(int(np.ceil(r["x1"] * s)), int(W * s)))
+    by = max(ay + 1, min(int(np.ceil(r["y1"] * s)), int(H * s)))
+    rad = BG_RING_PT
+    cols = np.empty((0, 3), dtype=np.float32)
+    A_h, A_w = arr.shape[:2]
+    while True:
+        pad = max(1, int(round(rad * dpi / 72.0)))
+        # Slice the window around the run instead of masking the whole page: a full-page
+        # boolean array per run cost 26x the old check on a 2-page document, and this is
+        # the same measurement without that allocation.
+        y0, y1 = max(0, ay - pad), min(A_h, by + pad)
+        x0, x1 = max(0, ax - pad), min(A_w, bx + pad)
+        sub = arr[y0:y1, x0:x1]
+        inner = np.zeros(sub.shape[:2], dtype=bool)
+        inner[max(0, ay - y0):max(0, by - y0), max(0, ax - x0):max(0, bx - x0)] = True
+        cols = sub[~inner].reshape(-1, 3)
+        if len(cols) >= BG_MIN_PX or rad >= BG_RING_MAX:
+            break
+        rad = min(BG_RING_MAX, rad * 2)
+    if len(cols) < BG_MIN_PX:
+        return None, 0.0
+    q = np.clip(np.rint(cols * 255.0), 0, 255).astype(np.uint8)
+    packed = (q[:, 0].astype(np.uint32) << 16) | (q[:, 1].astype(np.uint32) << 8) | q[:, 2]
+    vals, counts = np.unique(packed, return_counts=True)
+    k = int(vals[int(np.argmax(counts))])
+    bg = (((k >> 16) & 255) / 255.0, ((k >> 8) & 255) / 255.0, (k & 255) / 255.0)
+    near = int(np.all(np.abs(cols - np.array(bg, dtype=np.float32)) <= BG_TOL, axis=1).sum())
+    purity = near / float(len(cols))
+    if purity < BG_PURITY:
+        return None, purity
+    return bg, purity
+
